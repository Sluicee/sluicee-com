# URL к PocketBase API — публично доступный адрес, его открывает браузер посетителя,
# а не адрес внутри docker-сети. Локально: http://127.0.0.1:8090.
# На проде (сборка через docker-compose.yml → website.build.args): реальный домен,
# например https://pbsl.sluicee.com — иначе фронтенд у чужих браузеров не найдёт бэкенд.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# last.fm-ключ дёргается прямо из браузера (у API открытый CORS) —
# поэтому нужен префикс VITE_, иначе Vite не положит его во фронтенд-бандл
VITE_LASTFM_API_KEY=

# Эти переменные — только для PocketBase-хуков (cron и гостевая книга), в браузер не идут
YOUTUBE_API_KEY=
FANART_API_KEY=

# Уведомления в Discord о новых записях в гостевой книге (PocketBase-хук):
# 1. Через бота (отправка сообщения указанному ID пользователя в ЛС или ID канала):
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# 2. Опционально: через вебхук канала (если задан DISCORD_USER_ID, бот упомянет пользователя <@id>):
# DISCORD_WEBHOOK_URL=

